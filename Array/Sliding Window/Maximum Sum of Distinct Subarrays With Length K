class Solution {
public:
    long long maximumSubarraySum(vector<int>& nums, int k) {
        int n = nums.size();
        long long windowsum = 0 , maxAns = 0;
        unordered_map<int,int> mp;

        for(int i=0;i<k;i++){
            windowsum += nums[i];
            mp[nums[i]]++;
        }
        if(mp.size()==k){
            maxAns = windowsum;
        }
        for(int j=k;j<n;j++){
            windowsum += nums[j];
            mp[nums[j]]++;

            windowsum -= nums[j-k];
            mp[nums[j-k]]--;

            if(mp[nums[j-k]]==0){
                mp.erase(nums[j-k]);
            }
            if(mp.size()==k){
                maxAns = max(maxAns,windowsum);
            }
        }
        return maxAns;
    }
};
